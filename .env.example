# Redis connection URL
REDIS_URL=redis://localhost:6379/0

# PostgreSQL connection URL
DATABASE_URL=postgresql://postgres:password@localhost:5432/llmgateway

# PostgreSQL password (used by docker-compose)
POSTGRES_PASSWORD=postgres_dev_password

# Admin API secret key for administrative endpoints
ADMIN_SECRET_KEY=your-admin-secret-key-here

# Server-side pepper for API key HMAC-SHA-256 hashing
# CRITICAL: Never commit the real pepper value
# REQUIRED: Application will fail to start if this is not set
API_KEY_PEPPER=your-secret-pepper-here

# Grafana admin password (used by docker-compose)
GRAFANA_ADMIN_PASSWORD=admin

# OpenTelemetry OTLP exporter endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
